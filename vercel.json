{
  "framework": null,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{*.py,*.html,*.json,css/**,js/**,personas/**,templates/**,character_looks/**}"
    }
  },
  "crons": [
    {
      "path": "/api/generate/tick",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
