{
  "git": {
    "deploymentEnabled": true
  },
  "framework": null,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{*.py,*.html,*.json,*.txt,*.ico,*.png,css/**,js/**,img/**,personas/**,templates/**,character_looks/**,docs/**,masshype-preview/**}"
    }
  },
  "crons": [
    {
      "path": "/api/generate/tick",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/niche/refresh",
      "schedule": "0 5 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
