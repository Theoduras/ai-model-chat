# AI replies. Without it the app serves canned fallbacks.
GEMINI_API_KEY=your_gemini_api_key_here

# Signs session cookies. Required in production, or sign-ins break across instances.
SECRET_KEY=

# Postgres connection string. The SQLite default does not survive a redeploy.
DATABASE_URL=

# Origin third parties call back on (OAuth redirect, payment webhook), e.g.
# https://velvetfunneler.com. Only needed when the app answers on a different
# host than the one registered with Google/Oxapay/Stripe.
PUBLIC_BASE_URL=

# Sign in with Google. The button stays hidden until both are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; otherwise built as PUBLIC_BASE_URL + /auth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=

# Oxapay crypto payments. "Pay with crypto" stays hidden until this is set.
OXAPAY_MERCHANT_KEY=

# Stripe card payments. "Subscribe with card" stays hidden until both are set.
# Card plans are Stripe subscriptions and renew themselves; the webhook needs
# checkout.session.completed, invoice.paid and customer.subscription.deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: point a plan at a price in the Stripe catalogue instead of the
# inline price checkout builds by default. One per sellable plan, named after
# the tier key. Leave blank and checkout still works.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_AGENCY_ANNUAL=

# The referral discount needs no configuration: the 20%-off-first-month coupon
# is created in Stripe on the first referred checkout and its id is remembered
# in the database.

# Fanvue webhook signing secret (Developer Area → Events → View Signing Secret).
# Without it /webhooks/fanvue rejects every delivery, and purchases are only
# picked up by the slower reconciler.
FANVUE_WEBHOOK_SECRET=

# Lets a fan mark their own PPV as paid by typing the test phrase. Testing only
# — leave unset in production.
FANVUE_PPV_TEST_PHRASE_ENABLED=

# Keys for the programmatic API (/api/v1/chat), comma-separated. Callers pass
# one as `Authorization: Bearer <key>` or `X-API-Key`. Leaving this unset
# closes the endpoint — it is not behind the paywall, so the key is the only
# thing guarding it.
API_KEYS=

# ── Discord ───────────────────────────────────────────────────────────────────
# Discord runs on a real user account, not a bot application, which is against
# Discord's terms of service — accounts found doing it are terminated. Nothing
# below turns it on by itself: the account's token is pasted into the console and
# stored encrypted in the database, per persona.
#
# Holds the gateway connections and the reply worker. Off on Vercel, which has no
# always-on process for a socket to live in.
DISCORD_WORKER=
# Opens the sockets at startup for every persona with Discord switched on.
DISCORD_AUTOSTART=
# Encrypts the stored account tokens. A Fernet key; falls back to one derived
# from SECRET_KEY, so rotating SECRET_KEY orphans the stored tokens.
DISCORD_TOKEN_KEY=
# Signing in needs no Discord-specific configuration: it drives the same hosted
# browser OnlyFans uses, so ONLYFANS_BROWSER_URL / ONLYFANS_BROWSER_TOKEN and
# ONLYFANS_PROXY_TEMPLATE are what decide where the login window runs and which
# address it comes from. Without a browser service the window still works, in
# the app's own process — it just dies with the next deploy.
# What the client reports itself as. These change with Discord's own releases and
# a stale pair is refused at connect, so they are settable without a deploy.
DISCORD_BUILD=
DISCORD_CAPABILITIES=
# How long a fan has to stop typing before her reply goes out, so three lines in
# a row get one answer rather than three.
DISCORD_QUIET_SECONDS=
# The most messages one account will send in a day, whatever the personas ask
# for. Tripping it stands her down rather than hammering.
DISCORD_DAILY_CAP=

# ── NSFW image and video generation ──────────────────────────────────────────
# Google refuses NSFW at any safety level, so generation runs through a managed
# provider instead. Runware is the primary (CivitAI checkpoints plus video on
# one key); ModelsLab is the fallback, so one provider's terms changing costs an
# env var rather than the feature.
IMAGEGEN_PROVIDER=runware
RUNWARE_API_KEY=
MODELSLAB_API_KEY=
# Model ids per credit-price slot. The SDXL slot points at an NSFW-capable
# community checkpoint, which is the whole reason for not being on Google.
RW_MODEL_SDXL=
RW_MODEL_FLUX_SCHNELL=
RW_MODEL_FLUX_DEV=
RW_MODEL_QWEN=
RW_MODEL_VIDEO=
# How long a generation may run before it is failed and its credits refunded.
GEN_JOB_TIMEOUT=1800
GEN_SUBMIT_GRACE=120

# Generated media goes to GCS: a clip does not fit in the vault's data-URL
# column and Cloud Run's filesystem is in memory. A lifecycle rule on the
# staging/ prefix is what deletes an unkept generation after three days — the
# app installs it at boot, and without it nothing expires.
GCS_BUCKET=
GCS_SIGNED_URL_TTL=3600

# Signs the generation sweeper at /api/generate/tick. Vercel sends it as a
# bearer token on its own cron calls; an external pinger can use ?key= instead.
# Unset means the route stays shut, so on a host with no background worker set
# it or a failed generation holds its reserved credits forever.
CRON_SECRET=

# Object storage picks whichever backend is configured: GCS_BUCKET on Cloud Run,
# BLOB_READ_WRITE_TOKEN (Vercel Blob, set for you when a store is linked) on
# Vercel. STORAGE_BACKEND pins one when both are present. Blob has no lifecycle
# rules, so there the three-day staging purge rides on /api/generate/tick.
STORAGE_BACKEND=
BLOB_READ_WRITE_TOKEN=
